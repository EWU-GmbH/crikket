#!/bin/sh

# Format only staged files via lint-staged (configured in package.json).
# lint-staged backs up unstaged changes and restores them after formatting,
# rolling back automatically on failure. The previous hand-rolled hook ran
# `bun x ultracite fix` repo-wide and did its own stash push/pop; the
# repo-wide run rewrote ~55 untouched files (CRLF->LF on Windows) and the
# naive `git stash pop` then conflicted whenever unstaged edits overlapped
# with formatter output, stranding uncommitted work in the hook stash.
bun x lint-staged
